# MAGBO STUDIO — Environment Variables
# Copy this file to .env and fill in the values.

# ── Analytics (Optional) ──────────────────────────────────────────────
# Google Analytics Measurement ID (GA4)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics — automatically injected by Vercel, no config needed.

# PostHog API Key (if using PostHog instead of GA)
# VITE_POSTHOG_KEY=phc_XXXXXXXXXX
# VITE_POSTHOG_HOST=https://app.posthog.com

# ── Contact Form (Optional) ──────────────────────────────────────────
# API endpoint for the contact form submission
# VITE_CONTACT_API_URL=https://api.example.com/contact

# Formspree or similar service endpoint
# VITE_FORMSPREE_ID=xabcdefg

# ── Feature Flags ────────────────────────────────────────────────────
# Enable/disable CLI mode easter egg (default: true)
# VITE_ENABLE_CLI_MODE=true

# Enable/disable stealth telemetry (default: true in production)
# VITE_ENABLE_TELEMETRY=true
